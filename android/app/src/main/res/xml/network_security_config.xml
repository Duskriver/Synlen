<?xml version="1.0" encoding="utf-8"?>
<!-- 全局禁止明文 HTTP：业务端点均为 HTTPS；书内引用的远程 http 图片将加载失败（已知取舍）。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
